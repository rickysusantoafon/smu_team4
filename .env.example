# GEMINI_API_KEY: Server-side Gemini API key for AI market intelligence analysis.
# Automatically provided in AI Studio or configured in Vercel environment variables.
GEMINI_API_KEY=""

# YOUTUBE_API_KEY: YouTube Data API v3 key from Google Cloud Console.
# Required for live YouTube data requests. If not set, demo data mode is activated.
YOUTUBE_API_KEY=""

# Optional configurations
VITE_APP_NAME="TubeIntel"
VITE_DEFAULT_REGION="US"
DEFAULT_RPM_LOW=1.5
DEFAULT_RPM_BASE=4.0
DEFAULT_RPM_HIGH=8.5

